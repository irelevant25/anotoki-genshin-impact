{
  "name": "angular",
  "type": "module",
  "version": "1.8.0",
  "engines": {
    "node": "22.15.0"
  },
  "eslintConfig": {
    "settings": {
      "local-rules": {
        "location": "./eslint-local-rules.js"
      }
    }
  },
  "scripts": {
    "ng": "ng",
    "start": "bun ci && ng serve --port 4200 --proxy-config proxy.conf.json",
    "build": "ng build",
    "build:deploy": "ng build --configuration production && node scripts/prepare-deploy.mjs",
    "watch": "ng build --watch --configuration development",
    "lint": "npx eslint . --ext .ts",
    "lint-no-warn": "npx eslint . --ext .ts --quiet",
    "server": "lite-server",
    "bundle-analyze": "ng build && start https://esbuild.github.io/analyze/",
    "api:spec": "php ../backend/generate-api-spec.php",
    "api:client": "node generate-api.mjs",
    "api:docs": "node generate-openapi.mjs",
    "api": "npm run api:spec && npm run api:client && npm run api:docs"
  },
  "private": true,
  "sideEffects": true,
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-browser-dynamic": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@anotoki/lib": "https://github.com/irelevant25/anotoki-lib/releases/download/v0.11.1/anotoki-lib-0.11.1.tgz",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@anotoki/deploy": "https://github.com/irelevant25/anotoki-lib/releases/download/v0.9.0/anotoki-deploy-0.9.0.tgz",
    "@eslint/js": "^9.39.1",
    "@stylistic/eslint-plugin-ts": "^4.4.1",
    "baseline-browser-mapping": "^2.10.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-local": "^5.0.1",
    "eslint-plugin-local-rules": "^3.0.2",
    "lite-server": "^2.6.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
