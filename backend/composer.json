{
  "require": {
    "slim/slim": "^4.15",
    "slim/psr7": "^1.8",
    "anotoki/lib": "^0.11.0"
  },
  "scripts": {
    "start": [
      "Composer\\Config::disableProcessTimeout",
      "php -S localhost:8000 router.php"
    ]
  },
  "scripts-descriptions": {
    "start": "The API and setup.php on http://localhost:8000: PHP's built-in server, with router.php standing in for the hosting's Apache"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/irelevant25/anotoki-lib"
    }
  ],
  "extra": {
    "anotoki-deploy": {
      "site": "genshin",
      "remote": "/anotoki.eu/sub/genshin",
      "url": "https://genshin.anotoki.eu",
      "routes": [
        "api",
        "robots.txt",
        "sitemap.xml"
      ],
      "include": [
        "api",
        "config",
        "migrations",
        "vendor"
      ],
      "exclude": [
        "api/openapi.json",
        "api/docs.html",
        "api/httpd-vhosts.conf",
        "config/google.php"
      ],
      "frontendBuild": "npm run build:deploy",
      "beside": [
        "assets",
        "uploads"
      ],
      "types": {
        ".avif": "image/avif",
        ".opus": "audio/ogg"
      },
      "noCache": [
        "config.json",
        "changelog.json"
      ],
      "smoke": [
        "/api/site-status"
      ]
    }
  }
}
