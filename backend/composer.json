{
    "require": {
        "slim/slim": "^4.15",
        "slim/psr7": "^1.8",
        "anotoki/lib": "^0.4.1"
    },
    "scripts": {
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8000 router.php"
        ]
    },
    "scripts-descriptions": {
        "start": "The API and setup.php on http://localhost:8000: PHP's built-in server, with router.php standing in for the hosting's Apache"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/irelevant25/anotoki-lib"
        }
    ]
}
