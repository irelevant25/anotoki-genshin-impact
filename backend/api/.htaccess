RewriteEngine On

# Everything goes through index.php, real files and folders included. No other
# file under api/ is meant to be requested: the route and helper files, called
# on their own, die with a fatal error that names server paths. The first rule
# stops the rewrite looping on index.php itself.
#
# One thing this cannot catch: a path naming a folder here without its slash
# (/api/routes) is redirected by Apache to the folder before any rewrite runs.
# So no endpoint is named after a folder under api/ - the page table is
# /api/site-routes for that reason, and generate-api-spec.php refuses such a
# route. `DirectorySlash Off` would lift the redirect, but a host that does
# not allow it in .htaccess (AllowOverride Indexes) answers 500 for the whole
# API instead.
RewriteRule ^index\.php$ - [L]
RewriteRule ^ index.php [QSA,L]
